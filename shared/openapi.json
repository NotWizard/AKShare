    "/api/v1/refresh": {
      "post": {
        "tags": [
          "refresh"
        ],
        "summary": "Trigger",
        "description": "Run the fetch pipeline (blocks ~30s; cleared caches on success).\n\n``full=true`` bypasses the release calendar (fetch all tables).",
        "operationId": "trigger_api_v1_refresh_post",
        "parameters": [
          {
            "name": "full",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Full"
            }
