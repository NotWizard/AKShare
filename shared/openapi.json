      "get": {
        "tags": [
          "data"
        ],
        "summary": "Derived Monthly",
        "operationId": "derived_monthly_api_v1_derived_monthly_get",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          },
          {
            "name": "cols",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "comma-separated column subset",
              "title": "Cols"
            },
            "description": "comma-separated column subset"
          },
          {
            "name": "align_start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "if true, start from the earliest date where ALL requested value cols are non-null in the SAME row (so charts don't begin with a long empty run). Respects an explicit `start` (takes the later of the two). If any requested col is all-NaN, the filter is skipped (graceful degradation: returns full table from the user-provided start or 1978).",
              "default": false,
              "title": "Align Start"
            },
            "description": "if true, start from the earliest date where ALL requested value cols are non-null in the SAME row (so charts don't begin with a long empty run). Respects an explicit `start` (takes the later of the two). If any requested col is all-NaN, the filter is skipped (graceful degradation: returns full table from the user-provided start or 1978)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DerivedFrame"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
