            }
          }
        }
      }
    },
    "/api/v1/refresh/stream": {
      "get": {
        "tags": [
          "refresh"
        ],
        "summary": "Stream",
        "description": "SSE: real-time progress (0.0 → 1.0) then the final result.\n\nRuns the blocking refresh on a worker thread and polls a queue from the\ngenerator so progress lines stream as the fetcher emits them (not buffered\nuntil completion). Supports cancellation: if the client disconnects, the\nworker is signaled to stop early (kills subprocess + releases lockfile).",
        "operationId": "stream_api_v1_refresh_stream_get",
        "parameters": [
          {
            "name": "full",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Full"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
