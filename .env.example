# ============================================================================
#  环境变量模板 —— 复制为 .env 后按需填写：
#      cp .env.example .env
#  .env 已在 .gitignore 中（本文件 .env.example 必须可提交，勿加入忽略规则）。
#  本文件只放占位值，切勿写入任何真实密钥。
#
#  注意：本仓没有接 dotenv 自动加载（代码里没有 load_dotenv），.env 不会被自动读取。
#  用法二选一：
#      set -a; source .env; set +a; ./run_app.sh     # 注入当前 shell 后启动
#      COMMENTARY_API_KEY=... ./run_app.sh           # 单次覆盖
# ============================================================================

# ---- AI 点评（backend/app/core/commentary.py，OpenAI 兼容接口）----
# 三者必须同时非空才启用；任一为空时 /api/v1/commentary 返回
# "commentary model not configured: ..."，其余端点不受影响。
COMMENTARY_BASE_URL=https://api.openai.com/v1
COMMENTARY_API_KEY=sk-replace-me
COMMENTARY_MODEL=gpt-4o-mini

# ---- 刷新与健康（backend/app/core/refresh.py）----
# REFRESH_TIMEOUT_S：单次采集子进程的墙钟上限（秒），默认 300。
# HEALTH_STALE_DAYS：manifest 超过多少天算陈旧，默认 40（超过 2 倍判硬失败）。
REFRESH_TIMEOUT_S=300
HEALTH_STALE_DAYS=40

# ---- 其它可选开关（留空即用代码内默认值）----
# CORS 允许来源，逗号分隔（backend/app/main.py）。单进程部署下前端与 API 同源，
# 仅 `npm run dev`(:5173) 热重载时才需要。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CRCL 监控启动自动采集：置 0 关闭（backend/app/core/crcl_collect.py）。
CRCL_STARTUP_COLLECT=1
# macOS 上 expat 动态库目录（backend/app/core/refresh.py 注入采集子进程）。
EXPAT_LIB_PATH=/opt/homebrew/opt/expat/lib

# ---- run_app.sh 解释器覆盖（G27/O-M3）----
# 二者都不设时按 .venv312 → .venv → python3 顺序解析。
# PYTHON=/absolute/path/to/python
# VENV=/absolute/path/to/venv
